{
  "name": "link-calendar",
  "version": "3.4.2",
  "description": "Turn explicit Markdown dates and configured calendar notes into a low-noise, read-only Vault timeline.",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build-styles.mjs && node esbuild.config.mjs production",
    "dev": "node scripts/build-styles.mjs && node esbuild.config.mjs",
    "check": "tsc --noEmit && npm run lint:obsidian",
    "knip": "knip",
    "lint:obsidian": "eslint src tests",
    "test": "vitest run --coverage",
    "test:visual": "vitest run tests/view.test.ts tests/presentation.test.ts && node scripts/verify-visual-fixture.mjs",
    "verify": "npm run check && npm run knip && npm test && npm run test:visual && npm run build && node scripts/verify-release.mjs"
  },
  "keywords": [
    "obsidian",
    "calendar",
    "markdown",
    "notes"
  ],
  "author": "Woonyong Choi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woonyong-kr/link-calendar.git"
  },
  "engines": {
    "node": ">=20"
  },
  "knip": {
    "entry": [
      "scripts/*.mjs"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^20.11.15",
    "knip": "^6.33.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
